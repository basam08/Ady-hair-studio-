# ─────────────────────────────────────────────────────────────
#  Ady Hair Cut — variables de entorno (plantilla)
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas .env al control de versiones.
# ─────────────────────────────────────────────────────────────

# Base de datos — Postgres (Neon). Copia aquí la connection string de Neon.
# Formato: postgresql://usuario:pass@host/db?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/adyhaircut?sslmode=require"

# Secreto para firmar las sesiones del panel de administración (JWT).
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-bytes-minimo"

# Credenciales del primer administrador (solo se usan al ejecutar el seed).
ADMIN_EMAIL="ady@adyhaircut.com"
ADMIN_PASSWORD="CambiaEstaClave123!"

# URL pública del sitio (para enlaces en emails, canonical, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secreto para proteger el endpoint de recordatorios (cron).
# Genera uno con:  openssl rand -hex 32
CRON_SECRET="cambia-esto-por-un-token-aleatorio"

# ── Integraciones (opcionales — si se dejan vacías, se registran en consola) ──

# Email transaccional (Resend — resend.com, 3000 emails/mes gratis)
RESEND_API_KEY=""
EMAIL_FROM="ADY Hair Studio <reservas@adyhaircut.com>"

# WhatsApp / SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Google Calendar (Service Account)
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
