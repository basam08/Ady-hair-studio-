// Ady Hair Cut — esquema de datos
// Dev: SQLite. Para producción cambia el provider a "postgresql" o "mysql"
// y actualiza DATABASE_URL. La lógica de la app no depende del motor.

generator client {
  provider      = "prisma-client-js"
  // "native" para tu portátil; el target de Vercel para el despliegue.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // Postgres (Neon). DATABASE_URL = conexión pooled (app);
  // DATABASE_URL_UNPOOLED = conexión directa (migraciones / db push).
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Service {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String
  priceCents     Int
  durationMin    Int
  category       String
  active         Boolean   @default(true)
  // Si es false, no se puede reservar online (p. ej. mechas): el cliente
  // debe consultar por WhatsApp antes de que se le asigne un hueco.
  bookableOnline Boolean   @default(true)
  // Servicio "extra": no se reserva solo, se añade opcionalmente encima de
  // un servicio principal (p. ej. Planchar).
  isExtra        Boolean   @default(false)
  // Si es true, el precio se muestra como "Desde X €" (precio de partida,
  // el definitivo depende de una valoración presencial).
  priceFrom      Boolean   @default(false)
  sortOrder      Int       @default(0)
  bookings       Booking[]
}

model Stylist {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  role      String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  bookings  Booking[]
}

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  // En la papelera (soft-delete); se purga sola a los 30 días.
  deletedAt DateTime?
  bookings  Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  // Enlace público para que el cliente gestione su cita sin login.
  manageToken   String        @unique
  status        BookingStatus @default(CONFIRMED)

  clientId      String
  client        Client        @relation(fields: [clientId], references: [id])

  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  // Copia inmutable del servicio en el momento de reservar.
  serviceName   String
  priceCents    Int
  durationMin   Int

  // Nullable por compatibilidad con reservas creadas antes de tener
  // peluqueros nombrados en el sistema.
  stylistId     String?
  stylist       Stylist?      @relation(fields: [stylistId], references: [id])

  startsAt      DateTime
  endsAt        DateTime
  chair         Int           @default(1)

  clientNote    String?
  reminderSentAt DateTime?
  googleEventId String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // En la papelera (soft-delete); se purga sola a los 30 días.
  deletedAt     DateTime?

  @@index([startsAt])
  @@index([status])
}

model Blackout {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  reason   String
  allDay   Boolean  @default(false)

  @@index([startsAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}
